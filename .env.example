# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SESSION_SIGNING_SECRET: HMAC-SHA256 secret used by CSRF/session middleware.
# Configure a strong random value (32+ chars) in Vercel Production environment variables.
SESSION_SIGNING_SECRET="CHANGE_ME_TO_A_STRONG_RANDOM_SECRET"

# ALLOWED_SYSTEM_ORIGINS: Optional comma-separated list of authorized origins
# when connecting the Client App, Barber App, and shared backend domain.
ALLOWED_SYSTEM_ORIGINS=""
